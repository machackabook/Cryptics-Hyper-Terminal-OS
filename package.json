{
  "name": "cryptic",
  "version": "0.9.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3000",
    "lint": "tsc --noEmit",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:security": "npm run lint && node scripts/verify.mjs && node scripts/pages-security-audit.mjs --local-only",
    "test:security": "node --test tests/security.test.mjs tests/security-hardening.test.mjs",
    "test": "npm run test:security",
    "test:audit": "node scripts/pages-security-audit.mjs --local-only"
  },
  "dependencies": {
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
